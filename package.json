{
  "name": "painthelper-v2",
  "version": "0.22.0",
  "private": true,
  "description": "Miniature paint palette helper for Warhammer Age of Sigmar and Warhammer 40,000, with user accounts and SQLite storage.",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/server.js",
    "user": "node --disable-warning=ExperimentalWarning server/manage.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js",
    "test:browser": "node tests/browser-smoke.js",
    "test:server-browser": "node --disable-warning=ExperimentalWarning tests/server-browser.js",
    "test:ai-browser": "node --disable-warning=ExperimentalWarning tests/ai-browser.js",
    "update:catalogue": "node scripts/update-catalogue.js",
    "test:tablet-browser": "node --disable-warning=ExperimentalWarning tests/tablet-browser.js"
  },
  "devDependencies": {
    "playwright-core": "^1.60.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
